<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <ResponsivePopover id="draftEvidencePopover" title="{workspace>/selectedEvidence/label}" placement="Auto" showCloseButton="true" contentWidth="28rem" beforeClose=".extension.tide.cockpit.ext.controller.RequisitionWorkspace.onEvidenceClosing" afterClose=".extension.tide.cockpit.ext.controller.RequisitionWorkspace.onEvidenceClosed">
        <VBox id="evidencePopoverContent" class="sapUiSmallMargin tideEvidencePopover">
            <ObjectStatus id="evidenceStatus" text="{workspace>/selectedEvidence/statusText}" state="{workspace>/selectedEvidence/state}" class="sapUiTinyMarginTop" />
            <MessageStrip id="evidenceFailure" text="{workspace>/selectedEvidence/failureText}" type="Error" showIcon="true" visible="{= %{workspace>/selectedEvidence/status} === 'failed' }" class="sapUiSmallMarginTop" />
            <Title id="currentValueTitle" text="{i18nFreetext>currentValue}" level="H5" class="sapUiSmallMarginTop" />
            <Text id="currentValue" text="{workspace>/selectedEvidence/selectedText}" wrapping="true" />
            <Text id="currentProvenance" text="{workspace>/selectedEvidence/provenance}" wrapping="true" class="tideFieldOrigin" />
            <Button id="confirmCurrentEvidence" text="{i18nFreetext>confirmCurrentValue}" icon="sap-icon://accept" type="Transparent" visible="{workspace>/selectedEvidence/capabilities/canConfirm}" enabled="{= !%{workspace>/actionBusy} }" press=".extension.tide.cockpit.ext.controller.RequisitionWorkspace.onConfirmCurrent" />
            <MessageStrip id="evidenceStale" text="{parts: [{path: 'workspace>/selectedEvidence/invalidation/reasons'}], formatter: '.extension.tide.cockpit.ext.controller.RequisitionWorkspace.formatInvalidation'}" type="Warning" showIcon="true" visible="{= %{workspace>/selectedEvidence/status} === 'stale' }" class="sapUiSmallMarginTop" />
            <Title id="rankedCandidatesTitle" text="{i18nFreetext>rankedCandidates}" level="H5" visible="{workspace>/selectedEvidence/hasCandidates}" class="sapUiSmallMarginTop" />
            <List id="rankedCandidates" visible="{workspace>/selectedEvidence/hasCandidates}" items="{path: 'workspace>/selectedEvidence/alternatives'}" mode="{= (%{workspace>/selectedEvidence/capabilities/canApply} || %{workspace>/selectedEvidence/capabilities/canEditToApply}) ? 'SingleSelectLeft' : 'None' }" includeItemInSelection="true" selectionChange=".extension.tide.cockpit.ext.controller.RequisitionWorkspace.onCandidateSelected" noDataText="{workspace>/selectedEvidence/statusText}">
                <StandardListItem id="candidateItem" title="{workspace>displayText}" description="{parts: [{path: 'workspace>score'}], formatter: '.extension.tide.cockpit.ext.controller.RequisitionWorkspace.formatScore'}" selected="{= %{workspace>id} === %{workspace>/selectedCandidateID} }" />
            </List>
            <Title id="evidenceStrengthTitle" text="{i18nFreetext>whyThisValue}" level="H5" visible="{workspace>/selectedEvidence/hasExplanation}" class="sapUiSmallMarginTop" />
            <Text id="evidenceSummary" text="{workspace>/selectedEvidence/explanation/summary}" visible="{workspace>/selectedEvidence/hasSummary}" wrapping="true" />
            <Text id="evidenceReliability" text="{parts: [{path: 'workspace>/selectedEvidence/explanation/reliability/value'}, {path: 'workspace>/selectedEvidence/explanation/reliability/evaluationScope'}, {path: 'workspace>/selectedEvidence/explanation/reliability/sampleSize'}], formatter: '.extension.tide.cockpit.ext.controller.RequisitionWorkspace.formatReliability'}" visible="{workspace>/selectedEvidence/hasReliability}" wrapping="true" />
            <Text id="evidenceHistory" text="{workspace>/selectedEvidence/explanation/supportingHistory/agreementText}" visible="{workspace>/selectedEvidence/hasHistory}" wrapping="true" class="sapUiSmallMarginTop" />
            <Panel id="evidenceCalculationDetails" headerText="{i18nFreetext>calculationDetails}" visible="{workspace>/selectedEvidence/hasCalculation}" expandable="true" expanded="false" class="sapUiSmallMarginTop">
                <Text id="evidenceCalculation" text="{parts: [{path: 'workspace>/selectedEvidence/explanation/calculation/backend'}, {path: 'workspace>/selectedEvidence/explanation/calculation/modelVersion'}, {path: 'workspace>/selectedEvidence/explanation/calculation/computedAt'}], formatter: '.extension.tide.cockpit.ext.controller.RequisitionWorkspace.formatCalculation'}" visible="{workspace>/selectedEvidence/hasModelMetadata}" wrapping="true" />
                <Text id="evidenceFailureDetails" text="{workspace>/selectedEvidence/reason}" visible="{= %{workspace>/selectedEvidence/status} === 'failed' }" wrapping="true" />
            </Panel>
        </VBox>
        <beginButton><Button id="applySelectedEvidence" text="{i18nFreetext>applySelected}" icon="sap-icon://accept" type="Emphasized" visible="{= !!%{workspace>/selectedEvidence/capabilities/canApply} || !!%{workspace>/selectedEvidence/capabilities/canEditToApply} }" enabled="{= !!%{workspace>/canApplySelected} &amp;&amp; !%{workspace>/actionBusy} }" press=".extension.tide.cockpit.ext.controller.RequisitionWorkspace.onApplySelected" /></beginButton>
        <endButton><Button id="refreshCurrentEvidence" text="{i18nFreetext>refresh}" icon="sap-icon://refresh" visible="{workspace>/selectedEvidence/capabilities/canPredict}" enabled="{= !%{workspace>/actionBusy} }" press=".extension.tide.cockpit.ext.controller.RequisitionWorkspace.onRefreshCurrent" /></endButton>
    </ResponsivePopover>
</core:FragmentDefinition>
