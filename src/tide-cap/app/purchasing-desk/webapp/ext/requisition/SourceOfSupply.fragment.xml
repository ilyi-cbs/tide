            <macros:FormElement id="infoRecordElement" metaPath="reviewedPurchasingInfoRecord"><macros:fields><core:Fragment fragmentName="tide.cockpit.ext.requisition.InfoRecordField" type="XML" /></macros:fields></macros:FormElement>
