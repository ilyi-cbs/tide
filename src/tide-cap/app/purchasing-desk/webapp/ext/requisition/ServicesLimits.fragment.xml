<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form" xmlns:macros="sap.fe.macros">
    <f:Form id="serviceWorkingForm" editable="{ui>/isEditable}">
        <f:layout><f:ColumnLayout columnsM="1" columnsL="2" columnsXL="2" labelCellsLarge="12" /></f:layout>
        <f:formContainers><f:FormContainer><f:formElements>
            <macros:FormElement id="servicePerformerElement" metaPath="reviewedServicePerformer" />
            <macros:FormElement id="performanceStartElement" metaPath="reviewedPerformancePeriodStartDate" />
            <macros:FormElement id="performanceEndElement" metaPath="reviewedPerformancePeriodEndDate" />
            <macros:FormElement id="expectedLimitElement" metaPath="reviewedExpectedOverallLimitAmount" />
            <macros:FormElement id="overallLimitElement" metaPath="reviewedOverallLimitAmount" />
        </f:formElements></f:FormContainer></f:formContainers>
    </f:Form>
</core:FragmentDefinition>
