<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:macros="sap.fe.macros" xmlns:assist="tide.cockpit.ext.requisition">
    <assist:AssistedField width="100%">
        <HBox alignItems="Center" width="100%">
            <VBox>
                <layoutData><FlexItemData growFactor="{= %{ui>/isEditable} ? 1 : 0 }" shrinkFactor="1" baseSize="auto" /></layoutData>
                <macros:Field id="infoRecordWorkingField" contextPath="/PurchaseRequisitionReviews" metaPath="reviewedPurchasingInfoRecord" change=".extension.tide.cockpit.ext.controller.RequisitionWorkspace.onFieldChange" />
            </VBox>
            <Button id="infoRecordAssistant" icon="sap-icon://ai" type="Transparent" class="sapUiTinyMarginBegin" tooltip="{i18nFreetext>openInfoRecordAssistance}" visible="{workspace>/evidence/reviewedPurchasingInfoRecord/capabilities/canInspect}" press=".extension.tide.cockpit.ext.controller.RequisitionWorkspace.onEvidencePress">
                <layoutData><FlexItemData shrinkFactor="0" /></layoutData>
                <customData><core:CustomData key="property" value="reviewedPurchasingInfoRecord" /></customData>
            </Button>
        </HBox>
    </assist:AssistedField>
</core:FragmentDefinition>
