<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:p="tide.cockpit.ext.prevention">
    <VBox id="materialLeadTimeComparison" width="100%" class="tidePreventionComparison" core:require="{Workspace: 'tide/cockpit/ext/prevention/Workspace'}" modelContextChange="Workspace.onContextChange" busy="{prevention>/loading}">
        <core:Fragment fragmentName="tide.cockpit.ext.prevention.CaseSummary" type="XML" />
        <core:Fragment fragmentName="tide.cockpit.ext.prevention.LoadState" type="XML" />
        <MessageStrip text="{prevention>/banner}" type="Warning" showIcon="true" visible="{prevention>/loaded}" />
        <core:Fragment fragmentName="tide.cockpit.ext.prevention.PredictionControls" type="XML" />
        <HBox id="materialLeadTimeComparisonValues" width="100%" wrap="Wrap" class="tidePriceSummary tideComparisonSummary">
            <VBox id="materialLeadTimeCurrent" class="tidePreventionMetric"><Label text="Current master time" /><ObjectNumber number="{prevention>/row/currentDays}" unit="days" /></VBox>
            <VBox id="materialLeadTimeRecommended" class="tidePreventionMetric"><Label text="Proposed master time" /><ObjectNumber number="{prevention>/row/proposedDays}" unit="days" /></VBox>
            <VBox id="materialLeadTimeDifference" class="tidePreventionMetric"><Label text="Change from current" /><ObjectNumber number="{prevention>/delta}" unit="days" /></VBox>
            <VBox class="tidePreventionMetric"><Label text="Estimated delivery time" /><ObjectNumber number="{prevention>/modelComparison}" unit="days" visible="{prevention>/hasModelComparison}" /><ObjectStatus text="AI estimate · TabPFN" icon="sap-icon://ai" class="tideAIStatus" visible="{prevention>/hasModelComparison}" /><Text text="Weighted supplier medians" class="tidePreventionNote" visible="{prevention>/hasModelComparison}" /><Text text="Complete supplier coverage unavailable" wrapping="true" visible="{= !%{prevention>/hasModelComparison} }" /></VBox>
            <VBox class="tidePreventionMetric"><Label text="Allowed tolerance" /><ObjectNumber number="{prevention>/row/tolerance}" unit="days" /></VBox>
        </HBox>
        <core:Fragment fragmentName="tide.cockpit.ext.prevention.PlannedTimeEvidence" type="XML" />
        <Panel headerText="Current and Proposed Master Setting" expandable="true" expanded="false" visible="{prevention>/loaded}" class="sapUiMediumMarginTop"><p:EvidenceChart data="{prevention>/chart}" /></Panel>
    </VBox>
</core:FragmentDefinition>
