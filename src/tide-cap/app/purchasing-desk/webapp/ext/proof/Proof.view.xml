<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:macros="sap.fe.macros"
    controllerName="tide.cockpit.ext.proof.Proof"
    height="100%">
    <f:DynamicPage id="proofPage" headerExpanded="true" fitContent="false">
        <f:title>
            <f:DynamicPageTitle id="proofTitle">
                <f:heading>
                    <Title id="proofHeading" text="{i18n>proofTitle}" level="H2" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader id="proofHeader" pinnable="false">
                <MessageStrip id="proofExplain" type="Information" showIcon="true" text="{i18n>proofExplain}" />
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <VBox id="proofContent">
                <macros:Chart id="proofChart" metaPath="@com.sap.vocabularies.UI.v1.PresentationVariant#Mae" personalization="Type,Item" selectionMode="None" height="22rem" />
                <macros:Table id="proofTable" metaPath="@com.sap.vocabularies.UI.v1.LineItem" header="{i18n>proofTable}" readOnly="true" isSearchable="false" type="ResponsiveTable" growingThreshold="30" class="sapUiSmallMarginTop" />
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
