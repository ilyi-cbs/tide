# Central .env for cbs TIDE; every service reads it. `npm run setup` copies
# this file to .env. Put credentials only in .env and never commit it.
# Exported environment variables take precedence over .env.
#
# Defaults use Microsoft Foundry for the LLM and Prior Labs for tabular inference.

################################################################################
# ROOT NPM COMMANDS
################################################################################

# Paths are relative to the repository root.
CAP_PORT=4004
TIDE_DB=.data/retained/cap.sqlite
TIDE_DATASET=data/demo
TIDE_SOURCE_SYSTEM=local-demo
# Business-date override; defaults to the verified manifest's today.
# TIDE_AS_OF=2026-10-05
# How long startup waits for batch publication.
TIDE_PREPARE_TIMEOUT_MS=36000000
# 1 skips the stored predictions (<dataset>/predictions/) and recomputes them live.
TIDE_RECOMPUTE=0

################################################################################
# LLM GATEWAY (src/tide-agent/gateway)
################################################################################

# Upstream model route by provider:
#   Foundry v1 (OpenAI-compatible): openai/<deployment>
#     API_BASE=https://<resource>.services.ai.azure.com/openai/v1
#   Azure OpenAI classic:           azure/<deployment>
#     API_BASE=https://<resource>.openai.azure.com/  API_VERSION=2024-08-01-preview
#   Foundry (Claude, Mistral, ...): azure_ai/<model>
#     API_BASE=https://<resource>.services.ai.azure.com/anthropic
GATEWAY_PORT=4000
GATEWAY_UPSTREAM_MODEL=openai/gpt-5.6-luna
GATEWAY_UPSTREAM_API_KEY=
GATEWAY_UPSTREAM_API_BASE=
GATEWAY_UPSTREAM_API_VERSION=
# Distinct caller keys for the agent and CAP; blank generates per-launch keys.
GATEWAY_AGENT_KEY=
GATEWAY_CAP_KEY=

################################################################################
# AGENT SERVICE (src/tide-agent)
################################################################################

# npm start points the agent at the gateway (AGENT_MODEL*) and forces LLM_FAKE=0.

# --- CAP: MCP endpoints /mcp/<app>, runtime /rest/assistant-runtime, caller auth ---
# Derived from CAP_PORT when unset.
# CAP_URL=http://127.0.0.1:4004
MCP_TIMEOUT_SECONDS=30
# Seconds an accepted Authorization header is trusted before asking CAP again.
AUTH_CACHE_SECONDS=60

# --- Conversation store: checkpoints + thread owners (never credentials) ---
CHECKPOINT_DB=.data/retained/checkpoints.sqlite

# --- Budget (bounds a runaway tool-call loop / cost per turn) ---
MAX_STEPS=8
MAX_TOOL_CALLS=16
MAX_PARALLEL_TOOL_CALLS=8
# Conversation kept per thread (approximate tokens) and longest tool result sent to the LLM
MAX_HISTORY_TOKENS=60000
MAX_TOOL_RESULT_CHARS=20000
TURN_TIMEOUT_S=60

# --- Overload protection ---
MAX_CONCURRENT_TURNS=50

# --- CORS (comma-separated origins of the Fiori/chat UI; derived from CAP_PORT when unset) ---
# CORS_ORIGINS=http://127.0.0.1:4004,http://localhost:4004

# --- FastAPI service ---
AGENT_HOST=127.0.0.1
AGENT_PORT=8081
LOG_LEVEL=INFO

################################################################################
# TABULAR SERVICE (src/tide-tabular)
################################################################################

# priorlabs | aicore (SAP AI Core TabPFN); fake is for offline tests only.
TABULAR_BACKEND=priorlabs

# --- Prior Labs (only with TABULAR_BACKEND=priorlabs) ---
PRIORLABS_API_KEY=
PRIORLABS_MODEL_PATH=v3.5_default
PRIORLABS_MAX_TEST_BATCH=1000
PRIORLABS_MAX_CLASSES=160

# --- SAP AI Core (only with TABULAR_BACKEND=aicore) ---
AICORE_AUTH_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_RESOURCE_GROUP=default
# Either the full deployment URL ...
AICORE_DEPLOYMENT_URL=
# ... or the API URL plus the deployment ID
AICORE_API_URL=
AICORE_DEPLOYMENT_ID=
AICORE_MAX_TEST_BATCH=300
AICORE_MAX_CLASSES=160
AICORE_MIN_CALL_INTERVAL_SECONDS=0.2

# --- Limits (answers 413 LIMIT_EXCEEDED above them) ---
TABULAR_MAX_CONTEXT_ROWS=10000
TABULAR_MAX_TEST_ROWS=10000
TABULAR_MAX_COLUMNS=500
TABULAR_MAX_QUANTILE_LEVELS=99
TABULAR_MIN_CALL_BUDGET_SECONDS=1
TABULAR_MAX_CELLS=20000000
# Logical work including repeated training context and target across chunks
TABULAR_MAX_EXECUTION_CELLS=20000000
TABULAR_MAX_BODY_BYTES=200000000
# Test rows per backend call (never more than the backend accepts)
TABULAR_TEST_CHUNK_ROWS=1000
# Unfinished local jobs per process, including timed-out workers; more get 429
TABULAR_MAX_CONCURRENT_CALLS=4
# Used when the caller sends no X-Deadline-Ms
TABULAR_DEFAULT_DEADLINE_SECONDS=120
# CAP worker lease; at least TABULAR_TIMEOUT_MS (default 180000) + 30000.
# TABULAR_EXECUTION_LEASE_MS=210000

# --- FastAPI service ---
TABULAR_HOST=127.0.0.1
TABULAR_PORT=8080
